# Enable after registering this site's origin and /center/callback with Signa.
NEXT_PUBLIC_SIGNA_ENABLED=false
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3020

# Shared RPC, IPFS pinning and gateway service. Defaults to Juicebox Center.
# Center must allow this site's actual origin.
# NEXT_PUBLIC_JBCENTER_URL=https://juicebox.center

# Test-only server RPC overrides for local HTTP Anvil nodes; fail closed.
# Only localhost, 127.0.0.1 and ::1 are allowed. Never prefix with NEXT_PUBLIC_.
# METALOG_RPC_URLS={"84532":"http://127.0.0.1:8545"}

# Explicit public listing. All listed games are validated against chain evidence.
# Newly created markets have shareable /markets/:chainId/:projectId URLs.
METALOG_MARKETS=
